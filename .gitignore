# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Environment and local config (never commit)
.env
.env.*
!.env.example
config/environments/local.*
config/**/local_*.json

# Runtime data — the event store and recordings are generated artefacts.
# Anchored to the repo root: an unanchored `data/` matches any directory named `data`
# anywhere in the tree, which silently swallowed frontend/src/data/ (source code, not a
# generated artefact) from every commit until this was caught by a cold-clone test.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
recordings/

# Raw radar frame logs. Generated during bench sessions, sometimes large, and specific to one
# unit on one day — evidence for a test campaign, not source.
/var/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Downloaded helper binaries (the pmtiles extract tool). Fetched on demand by
# ./install-basemap.sh, never committed.
/.tools/
