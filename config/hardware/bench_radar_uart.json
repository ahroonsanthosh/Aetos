{
  "schema_version": "1.0.0",
  "registry_key": "bench_radar_uart",
  "sensor_type": "radar",
  "description": "Bench-test 24GHz FMCW radar module read over a USB-to-TTL serial link. Rated for vehicle-scale returns and unverified against small airframes; every figure below is a pessimistic placeholder to be replaced by measurements taken on the bench.",
  "link": {
    "port": "/dev/ttyUSB0",
    "baud_rate": 115200,
    "read_timeout_s": 0.2,
    "silence_timeout_s": 5.0
  },
  "protocol": {
    "approaching_code": 1,
    "azimuth_sign": 1
  },
  "coverage": {
    "max_range_m": 100.0,
    "min_range_m": 0.0,
    "azimuth_extent_deg": 40.0,
    "elevation_beamwidth_deg": 20.0
  },
  "uncertainty": {
    "range_sigma_m": 2.0,
    "azimuth_sigma_deg": 4.0,
    "radial_velocity_sigma_mps": 1.0
  },
  "quality": {
    "signal_level_full_confidence": 60,
    "min_confidence": 0.2,
    "max_confidence": 0.8
  },
  "tilt_deg": 0.0,
  "report_interval_s": 0.1
}
