    "range_sigma_m": 400.0,
    "cross_range_sigma_m": 60.0,
    "cross_range_sigma_mrad": 30.0,
    "vertical_sigma_m": 300.0
  },
  "confidence": {
    "near_range": 0.8,
    "far_range": 0.45,
    "jitter_sigma": 0.06,
    "false_alarm_scale": 0.65
  },
  "probability_of_detection": 0.6,
  "false_alarm_rate_hz": 0.1,
  "radial_velocity": {
    "reported": false,
    "sigma_mps": 0.0
  },
  "classification": {
    "correct_probability": 0.65,
    "confusable_with": ["unknown_uas", "unknown", "other"],
    "confidence_when_correct": 0.7,
    "confidence_when_confused": 0.35
  }
}
